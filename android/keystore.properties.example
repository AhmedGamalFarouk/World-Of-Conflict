# Copy to android/keystore.properties (git-ignored) and fill in. The keystore
# lives OUTSIDE the repo; storeFile is an absolute path, forward slashes.
# Create it once:
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=C:/Users/you/keys/upload.jks
storePassword=
keyAlias=upload
keyPassword=
